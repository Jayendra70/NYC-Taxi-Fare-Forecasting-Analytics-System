PORT=5001
PYTHON_MICROSERVICE_URL=http://127.0.0.1:8000

# Comma-separated origins allowed to call the gateway (defaults to any origin)
# ALLOWED_ORIGINS=http://localhost:5173

# Optional. Enables traffic-aware distance, duration and tolls from the Google
# Routes API (the key needs the Routes API enabled, not Distance Matrix).
# Without it the gateway estimates the route from straight-line distance.
GOOGLE_MAPS_API_KEY=

# API Gateway Configuration
# Copy this file to .env and fill in your values

PORT=5001
PYTHON_MICROSERVICE_URL=http://127.0.0.1:8000

# Google Routes API Key (enables live traffic enrichment + toll calculation)
# Get yours at: https://console.cloud.google.com/apis/credentials
# Required permissions: Routes API (not the legacy Distance Matrix API)
GOOGLE_MAPS_API_KEY=your_google_routes_api_key_here
